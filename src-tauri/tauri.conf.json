{
  "productName": "MikroTik Auto Config Studio",
  "version": "2.0.0-alpha.2",
  "identifier": "vn.vietphuong.mikrotikstudio",
  "build": {
    "frontendDist": "../desktop-dist",
    "beforeBuildCommand": "node scripts/prepare-desktop.cjs",
    "beforeDevCommand": "node scripts/prepare-desktop.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MikroTik Auto Config Studio",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": [
      "nsis"
    ]
  }
}
